<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="64dp"
        android:paddingVertical="36dp">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_volume_lock" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/app_name"
            android:textAppearance="@style/TextAppearance.VolumeLimiter.Title" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/status_inactive"
            android:textAppearance="@style/TextAppearance.VolumeLimiter.Status" />

        <TextView
            android:id="@+id/currentVolumeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/current_volume_placeholder"
            android:textAppearance="@style/TextAppearance.VolumeLimiter.Body" />

        <TextView
            android:id="@+id/limitText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/limit_volume_placeholder"
            android:textAppearance="@style/TextAppearance.VolumeLimiter.Body" />

        <SeekBar
            android:id="@+id/limitSeekBar"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:focusable="true"
            android:progressTint="@color/accent"
            android:thumbTint="@color/accent" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/saveButton"
                android:layout_width="200dp"
                android:layout_height="56dp"
                android:text="@string/save_limit" />

            <Button
                android:id="@+id/toggleButton"
                android:layout_width="200dp"
                android:layout_height="56dp"
                android:layout_marginStart="16dp"
                android:text="@string/enable_limiter" />
        </LinearLayout>

        <Button
            android:id="@+id/accessibilityButton"
            android:layout_width="280dp"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:text="@string/open_accessibility_settings" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center"
            android:text="@string/output_notice"
            android:textAppearance="@style/TextAppearance.VolumeLimiter.Note" />
    </LinearLayout>
</ScrollView>
